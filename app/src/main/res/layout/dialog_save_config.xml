<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:hint="Nombre del archivo (.yoni)"
            app:boxBackgroundColor="@color/bg_input">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etSaveFilename"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:textColor="@color/text_primary" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="BLOQUEOS Y ENCRIPTACIÓN"
            android:textColor="@color/accent_cyan"
            android:textSize="11sp"
            android:textStyle="bold" />

        <CheckBox
            android:id="@+id/cbLockAll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="Bloquear Todo (payload, servidor, usuario y proxy)"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

        <CheckBox
            android:id="@+id/cbLockPayloadOnly"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Bloquear solo Payload (dejar servidor libre)"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

        <CheckBox
            android:id="@+id/cbUnlockUserPass"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Dejar Usuario y Contraseña editables"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

        <CheckBox
            android:id="@+id/cbUnlockProxy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Dejar Proxy remoto editable"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="4dp"
            android:text="SEGURIDAD Y PERMISOS"
            android:textColor="@color/accent_cyan"
            android:textSize="11sp"
            android:textStyle="bold" />

        <CheckBox
            android:id="@+id/cbAllowWifiShare"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="Permitir pasar Wi-Fi (Hotspot) a otros dispositivos"
            android:textColor="@color/accent_green"
            android:textSize="13sp" />

        <CheckBox
            android:id="@+id/cbMobileDataOnly"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Solo Datos Móviles (bloquear Wi-Fi)"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

        <CheckBox
            android:id="@+id/cbBlockRoot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Bloquear celulares con Root"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

        <CheckBox
            android:id="@+id/cbLockHwid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Bloquear para un HWID específico"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilSaveTargetHwid"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:hint="HWID permitido (ej: HCY-XXXX-XXXX-XXXX)"
            android:visibility="gone"
            app:boxBackgroundColor="@color/bg_input">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etSaveTargetHwid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:inputType="textCapCharacters|textNoSuggestions"
                android:textColor="@color/accent_cyan"
                android:textSize="13sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <CheckBox
            android:id="@+id/cbLockExpired"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Fecha de vencimiento (expiración)"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPickExpiryDate"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="Elegir fecha de vencimiento"
            android:textColor="@color/accent_amber"
            android:visibility="gone"
            app:strokeColor="@color/stroke_subtle" />

        <CheckBox
            android:id="@+id/cbUseFilePassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Proteger archivo con contraseña extra"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilSaveFilePassword"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:hint="Contraseña del archivo"
            android:visibility="gone"
            app:boxBackgroundColor="@color/bg_input"
            app:endIconMode="password_toggle">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etSaveFilePassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPassword"
                android:textColor="@color/text_primary" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="4dp"
            android:text="BANNERS EN PANTALLA"
            android:textColor="@color/accent_cyan"
            android:textSize="11sp"
            android:textStyle="bold" />

        <CheckBox
            android:id="@+id/cbShowNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Agregar Nota / Banner HTML visible en pantalla"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilSaveNote"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:hint="Texto o código HTML del banner"
            android:visibility="gone"
            app:boxBackgroundColor="@color/bg_input">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etSaveNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top|start"
                android:inputType="textMultiLine"
                android:maxLines="6"
                android:minLines="2"
                android:textColor="@color/text_primary" />
        </com.google.android.material.textfield.TextInputLayout>

        <CheckBox
            android:id="@+id/cbHideServerBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ocultar mensajes/banner propios de la VPS"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

    </LinearLayout>
</ScrollView>
