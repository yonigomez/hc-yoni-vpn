<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary">

    <!-- PANTALLA PRINCIPAL -->
    <LinearLayout
        android:id="@+id/rootContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg_primary"
        android:orientation="vertical">

        <!-- Barra superior -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingTop="10dp"
            android:paddingBottom="6dp">

            <ImageButton
                android:id="@+id/btnOpenDrawer"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginEnd="6dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Abrir menú"
                android:padding="9dp"
                android:src="@drawable/ic_menu" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.04"
                    android:text="@string/app_name"
                    android:textColor="@color/text_primary"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SSH Directo • Payload • Juegos 7300"
                    android:textColor="@color/accent_cyan"
                    android:textSize="11sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnImportConfig"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Importar archivo .yoni"
                android:padding="9dp"
                android:src="@drawable/ic_download_file" />

            <ImageButton
                android:id="@+id/btnExportConfig"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Guardar archivo encriptado"
                android:padding="9dp"
                android:src="@drawable/ic_upload_file" />

            <ImageButton
                android:id="@+id/btnClearConfig"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Borrar configuración"
                android:padding="9dp"
                android:src="@drawable/ic_delete" />
        </LinearLayout>

        <!-- Tarjeta de Estado, Horas y Botón Conectar -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="14dp"
            android:layout_marginBottom="8dp"
            app:cardBackgroundColor="@color/bg_surface"
            app:cardCornerRadius="20dp"
            app:strokeColor="@color/stroke_subtle"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/badgeStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_status_badge"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="4dp"
                        android:text="@string/status_disconnected"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvLockedBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="🔒 PROTEGIDO"
                        android:textColor="@color/accent_amber"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:visibility="gone" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/tvDuration"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:text="⏱ 0h 00m 00s"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvConnectionSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:text="Listo para conectar"
                    android:textColor="@color/text_secondary"
                    android:textSize="12.5sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvDownSpeed"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="monospace"
                        android:text="↓ 0 B/s"
                        android:textColor="@color/accent_green"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvUpSpeed"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="monospace"
                        android:gravity="center"
                        android:text="↑ 0 B/s"
                        android:textColor="@color/accent_cyan"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvTotalTraffic"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="monospace"
                        android:gravity="end"
                        android:text="Total: 0 B"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnConnectToggle"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="10dp"
                    android:text="@string/btn_connect"
                    android:textColor="@color/bg_primary"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/accent_cyan"
                    app:cornerRadius="15dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Botón compacto para volver a mostrar el banner cuando está oculto -->
        <TextView
            android:id="@+id/btnShowBannerPill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_status_badge"
            android:paddingHorizontal="14dp"
            android:paddingVertical="5dp"
            android:text="📢 Mostrar aviso / banner"
            android:textColor="@color/accent_cyan"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- Tarjeta de Banner HTML / Aviso del Servidor o Archivo -->
        <LinearLayout
            android:id="@+id/cardBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="14dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_banner_card"
            android:orientation="vertical"
            android:paddingHorizontal="10dp"
            android:paddingTop="8dp"
            android:paddingBottom="6dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvBannerTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="📢 AVISO DEL SERVIDOR"
                    android:textColor="@color/accent_cyan"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnExpandBanner"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:text="Ampliar"
                    android:textColor="@color/accent_green"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnHideBanner"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:text="Ocultar"
                    android:textColor="@color/accent_amber"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <WebView
                android:id="@+id/webBannerPreview"
                android:layout_width="match_parent"
                android:layout_height="155dp"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- Pestañas deslizables -->
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabLayout"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@color/bg_surface"
            app:tabGravity="fill"
            app:tabIndicatorColor="@color/accent_cyan"
            app:tabIndicatorHeight="3dp"
            app:tabMode="fixed"
            app:tabSelectedTextColor="@color/accent_cyan"
            app:tabTextColor="@color/text_secondary" />

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/viewPager"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>

    <!-- MENÚ LATERAL COMPLETO -->
    <ScrollView
        android:id="@+id/drawerPanel"
        android:layout_width="310dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/bg_surface"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingBottom="12dp">

                <ImageView
                    android:id="@+id/ivDrawerLogo"
                    android:layout_width="94dp"
                    android:layout_height="94dp"
                    android:contentDescription="Logo HC YONI"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_yoni_logo" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:letterSpacing="0.05"
                    android:text="HC YONI"
                    android:textColor="@color/text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Creado por Jonathan Gastón Gómez"
                    android:textColor="@color/accent_cyan"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Contacto: +54 9 3873 063499"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginBottom="12dp"
                android:background="@color/stroke_subtle" />

            <!-- Tarjeta de HWID -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_console"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="IDENTIFICADOR HWID DEL EQUIPO"
                    android:textColor="@color/accent_cyan"
                    android:textSize="10.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvDrawerHwid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="monospace"
                    android:text="HCY-0000-0000-0000"
                    android:textColor="@color/accent_green"
                    android:textIsSelectable="true"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDrawerCopyHwid"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="8dp"
                    android:text="Copiar HWID"
                    android:textColor="@color/accent_cyan"
                    android:textSize="12sp"
                    app:icon="@drawable/ic_copy"
                    app:iconGravity="textStart"
                    app:iconTint="@color/accent_cyan"
                    app:strokeColor="@color/stroke_subtle" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDrawerWifiShare"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:gravity="start|center_vertical"
                android:text="Pasar Wi-Fi (Apagado)"
                android:textColor="@color/accent_cyan"
                app:icon="@drawable/ic_wifi_share"
                app:iconGravity="start"
                app:iconPadding="12dp"
                app:iconTint="@color/accent_cyan"
                app:strokeColor="@color/stroke_subtle" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDrawerSettings"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:gravity="start|center_vertical"
                android:text="Ajustes (7300, DNS, Inicio, Batería)"
                android:textColor="@color/text_primary"
                app:icon="@drawable/ic_settings"
                app:iconGravity="start"
                app:iconPadding="12dp"
                app:iconTint="@color/accent_green"
                app:strokeColor="@color/stroke_subtle" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDrawerExcludedApps"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:gravity="start|center_vertical"
                android:text="Aplicaciones excluidas (0)"
                android:textColor="@color/text_primary"
                app:icon="@drawable/ic_apps"
                app:iconGravity="start"
                app:iconPadding="12dp"
                app:iconTint="@color/accent_cyan"
                app:strokeColor="@color/stroke_subtle" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDrawerSaveEncrypted"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:gravity="start|center_vertical"
                android:text="Guardar Encriptado (.yoni)"
                android:textColor="@color/accent_cyan"
                app:icon="@drawable/ic_upload_file"
                app:iconGravity="start"
                app:iconPadding="12dp"
                app:iconTint="@color/accent_cyan"
                app:strokeColor="@color/stroke_subtle" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDrawerImport"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:gravity="start|center_vertical"
                android:text="Importar Archivo (.yoni)"
                android:textColor="@color/text_primary"
                app:icon="@drawable/ic_download_file"
                app:iconGravity="start"
                app:iconPadding="12dp"
                app:iconTint="@color/text_primary"
                app:strokeColor="@color/stroke_subtle" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDrawerBattery"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:gravity="start|center_vertical"
                android:text="No Suspender App / Batería"
                android:textColor="@color/accent_green"
                app:icon="@drawable/ic_shield_lock"
                app:iconGravity="start"
                app:iconPadding="12dp"
                app:iconTint="@color/accent_green"
                app:strokeColor="@color/stroke_subtle" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDrawerUsageNotice"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:gravity="start|center_vertical"
                android:text="Avisos de Uso y Créditos"
                android:textColor="@color/text_primary"
                app:icon="@drawable/ic_info"
                app:iconGravity="start"
                app:iconPadding="12dp"
                app:iconTint="@color/text_primary"
                app:strokeColor="@color/stroke_subtle" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDrawerContact"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:gravity="start|center_vertical"
                android:text="WhatsApp: 3873063499"
                android:textColor="@color/bg_primary"
                android:textStyle="bold"
                app:backgroundTint="@color/accent_green"
                app:icon="@drawable/ic_chat"
                app:iconGravity="start"
                app:iconPadding="12dp"
                app:iconTint="@color/bg_primary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDrawerClearConfig"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="start|center_vertical"
                android:text="Borrar Configuración Actual"
                android:textColor="@color/accent_red"
                app:icon="@drawable/ic_delete"
                app:iconGravity="start"
                app:iconPadding="12dp"
                app:iconTint="@color/accent_red"
                app:strokeColor="@color/accent_red" />
        </LinearLayout>
    </ScrollView>

</androidx.drawerlayout.widget.DrawerLayout>
